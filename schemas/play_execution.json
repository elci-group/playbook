{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://playbook.local/schemas/play_execution.json",
  "title": "ELCI play execution envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["drive_id", "play_id", "operation", "capability_id", "budget_ceiling", "idempotency_key"],
  "properties": {
    "drive_id": { "type": "string" },
    "play_id": { "type": "string" },
    "operation": { "type": "string" },
    "capability_id": { "type": "string" },
    "capability_generation": { "type": "integer" },
    "budget_ceiling": { "type": "object" },
    "idempotency_key": { "type": "string" },
    "expected_evidence": { "type": "array" },
    "side_effect": { "type": "string" },
    "timeout_ms": { "type": "integer" }
  }
}
