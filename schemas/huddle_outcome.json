{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://playbook.local/schemas/huddle_outcome.json",
  "title": "Huddle outcome",
  "type": "object",
  "additionalProperties": false,
  "required": ["huddle_id", "reconciled_state", "resolved_contradictions", "unresolved_contradictions", "assignment_changes", "strategy_change", "personnel_changes", "revised_ytg_milli", "next_play", "next_huddle_conditions", "escalated_to"],
  "properties": {
    "huddle_id": { "type": "string" },
    "reconciled_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verified_evidence", "gate_snapshots", "assumptions"],
      "properties": {
        "verified_evidence": { "type": "array", "items": { "type": "string" } },
        "gate_snapshots": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["gate_id", "weight_ppm", "satisfaction_ppm", "state"],
            "properties": {
              "gate_id": { "type": "string" },
              "weight_ppm": { "type": "integer", "minimum": 0 },
              "satisfaction_ppm": { "type": "integer", "minimum": 0 },
              "state": { "type": "string" }
            }
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["subject", "previous", "current", "evidence_ref"],
            "properties": {
              "subject": { "type": "string" },
              "previous": { "type": "string" },
              "current": { "type": "string" },
              "evidence_ref": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    "resolved_contradictions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["contradiction_id", "state", "evidence_ref", "authority"],
        "properties": {
          "contradiction_id": { "type": "string" },
          "state": { "enum": ["resolved_by_evidence", "resolved_by_supersession", "resolved_by_authority", "deferred", "unresolved_blocking"] },
          "evidence_ref": { "type": ["string", "null"] },
          "authority": { "type": ["string", "null"] }
        }
      }
    },
    "unresolved_contradictions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "subject", "claims", "severity"],
        "properties": {
          "id": { "type": "string" },
          "subject": { "type": "string" },
          "claims": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["personnel_id", "statement", "evidence_ref"],
              "properties": {
                "personnel_id": { "type": "string" },
                "statement": { "type": "string" },
                "evidence_ref": { "type": ["string", "null"] }
              }
            }
          },
          "severity": { "enum": ["low", "medium", "high", "critical"] }
        }
      }
    },
    "assignment_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["personnel_id", "from", "to"],
        "properties": {
          "personnel_id": { "type": "string" },
          "from": { "type": ["string", "null"] },
          "to": { "type": "string" }
        }
      }
    },
    "strategy_change": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["subject", "from", "to", "justification"],
      "properties": {
        "subject": { "type": "string" },
        "from": { "type": "string" },
        "to": { "type": "string" },
        "justification": { "type": "string" }
      }
    },
    "personnel_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["personnel_id", "action", "reason"],
        "properties": {
          "personnel_id": { "type": "string" },
          "action": { "enum": ["substitution_recommended", "release", "reassign", "rest"] },
          "reason": { "type": "string" }
        }
      }
    },
    "revised_ytg_milli": { "type": ["integer", "null"] },
    "next_play": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["operation", "rationale", "target_gate"],
      "properties": {
        "operation": { "type": "string" },
        "rationale": { "type": "string" },
        "target_gate": { "type": ["string", "null"] }
      }
    },
    "next_huddle_conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "reason_code"],
        "properties": {
          "kind": { "enum": ["success", "failure", "strategic", "coherence_debt", "manual_authority"] },
          "reason_code": { "type": "string" }
        }
      }
    },
    "escalated_to": { "enum": ["position", "unit", "coordinator", "team", "franchise", null] }
  }
}
