export function checkWithMe(providerInstability: int, problemIndependence: int, coupling: int): string {
  if (providerInstability > 700) {
    return "heavy"
  }
  if (problemIndependence >= 600 && coupling <= 400) {
    return "spread"
  }
  return "bunch"
}

function main(): int {
  console.log(checkWithMe(800, 700, 200))
  console.log(checkWithMe(200, 700, 200))
  console.log(checkWithMe(200, 300, 700))
  return 0
}

test("provider instability concentrates first", () => {
  expect(checkWithMe(800, 700, 200)).toBe("heavy")
  expect(checkWithMe(701, 700, 200)).toBe("heavy")
})

test("independent broad problems spread", () => {
  expect(checkWithMe(200, 700, 200)).toBe("spread")
  expect(checkWithMe(200, 600, 400)).toBe("spread")
})

test("coupled problems bunch", () => {
  expect(checkWithMe(200, 300, 700)).toBe("bunch")
  expect(checkWithMe(200, 599, 401)).toBe("bunch")
})

test("the ladder is deterministic", () => {
  expect(checkWithMe(800, 700, 200)).toBe(checkWithMe(800, 700, 200))
  expect(checkWithMe(200, 700, 200)).toBe(checkWithMe(200, 700, 200))
  expect(checkWithMe(200, 300, 700)).toBe(checkWithMe(200, 300, 700))
})
