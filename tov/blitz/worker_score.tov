function clampPerMille(value: int): int {
  let capped = value
  if (capped < 0) {
    capped = 0
  }
  if (capped > 1000) {
    capped = 1000
  }
  return capped
}

function clampLatency(value: int): int {
  let capped = value
  if (capped < 0) {
    capped = 0
  }
  if (capped > 2000) {
    capped = 2000
  }
  return capped
}

export function workerScore(successPpm: int, latencyMs: int, availabilityPpm: int, costMilli: int): int {
  const successMilli = clampPerMille(Math.trunc(successPpm / 1000))
  const speedMilli = 1000 - Math.trunc((clampLatency(latencyMs) * 1000) / 2000)
  const availabilityMilli = clampPerMille(Math.trunc(availabilityPpm / 1000))
  return 4 * successMilli + 3 * speedMilli + 3 * 1000 + 2 * availabilityMilli - 1 * costMilli
}

function main(): int {
  console.log(workerScore(1000000, 0, 1000000, 0))
  console.log(workerScore(500000, 1000, 500000, 100))
  console.log(workerScore(0, 2000, 0, 0))
  return 0
}

test("weights are success 4, speed 3, independence 3, availability 2, cost 1", () => {
  expect(workerScore(1000000, 0, 1000000, 0)).toBe(12000)
  expect(workerScore(500000, 1000, 500000, 100)).toBe(7400)
  expect(workerScore(0, 2000, 0, 0)).toBe(3000)
})

test("components clamp to 0..=1000 per-mille", () => {
  expect(workerScore(2000000, 0, 1000000, 0)).toBe(12000)
  expect(workerScore(-100000, 0, -1, 0)).toBe(6000)
})

test("speed halves at 1000 ms and dies at 2000 ms", () => {
  expect(workerScore(1000000, 1000, 0, 0)).toBe(8500)
  expect(workerScore(1000000, 2000, 0, 0)).toBe(7000)
  expect(workerScore(1000000, 5000, 0, 0)).toBe(7000)
})

test("cost discounts the score and can sink it", () => {
  expect(workerScore(1000000, 0, 0, 500)).toBe(9500)
  expect(workerScore(0, 2000, 0, 5000)).toBe(-2000)
})
